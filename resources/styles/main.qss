/* ============================================================
 * WordMemorizer 全局样式表
 * 配色方案基于 Element UI：
 *   主色 #409eff | 成功 #67c23a | 警告 #e6a23c | 危险 #f56c6c
 *   背景 #f5f7fa | 文字 #2c3e50 | 边框 #dcdfe6
 * ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: #f5f7fa;
    color: #2c3e50;
}

QWidget {
    color: #2c3e50;
    font-size: 14px;
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
}

/* ---- 分组框 ---- */
QGroupBox {
    font-weight: bold;
    font-size: 14px;
    color: #2c3e50;
    border: 2px solid #dcdfe6;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 10px 10px 10px;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: #409eff;
}

/* ---- 输入控件 ---- */
QLineEdit,
QComboBox {
    border: 2px solid #dcdfe6;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: white;
    color: #2c3e50;
    selection-background-color: #409eff;
    selection-color: white;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #409eff;
    background-color: #f0f7ff;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10%;
}

QComboBox::down-arrow {
    image: url(:/resources/icons/dropdown.png);
    width: 16px;
    height: 16px;
}

/* ---- QSpinBox ---- */
QSpinBox {
    padding: 8px 22px 8px 12px;
    border: 2px solid #dcdfe6;
    border-radius: 6px;
    background-color: white;
    font-size: 14px;
    color: #2c3e50;
    min-height: 20px;
}

QSpinBox:focus {
    border-color: #409eff;
    background-color: #f0f7ff;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    height: 12px;
    border: none;
    background: transparent;
    image: url(:/resources/icons/up_arrow_normal.png);
    margin-top: 2px;
    margin-right: 2px;
}

QSpinBox::up-button:hover {
    image: url(:/resources/icons/up_arrow_hover.png);
}

QSpinBox::up-button:pressed {
    image: url(:/resources/icons/up_arrow_pressed.png);
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    height: 12px;
    border: none;
    background: transparent;
    image: url(:/resources/icons/down_arrow_normal.png);
    margin-bottom: 2px;
    margin-right: 2px;
}

QSpinBox::down-button:hover {
    image: url(:/resources/icons/down_arrow_hover.png);
}

QSpinBox::down-button:pressed {
    image: url(:/resources/icons/down_arrow_pressed.png);
}

/* ---- 按钮（渐变主样式） ---- */
QPushButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #409eff, stop: 1 #337ecc);
    border: none;
    border-radius: 6px;
    color: white;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 14px;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #66b1ff, stop: 1 #5298e6);
}

QPushButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3a8ee6, stop: 1 #2d7fcc);
}

QPushButton:disabled {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #c0c4cc, stop: 1 #a8abb2);
    color: #909399;
}

/* 绿色按钮（添加/保存） */
#m_addButton,
#m_editSaveButton,
#addDefinitionButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #67c23a, stop: 1 #529b2e);
}

#m_addButton:hover,
#m_editSaveButton:hover,
#addDefinitionButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #85ce61, stop: 1 #6bb749);
}

#m_addButton:pressed,
#m_editSaveButton:pressed,
#addDefinitionButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #5daf34, stop: 1 #4a8c2a);
}

/* 红色按钮（删除/取消/退出） */
#m_deleteButton,
#m_editCancelButton,
#m_exitPracticeButton,
#removeDefinitionButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f56c6c, stop: 1 #d65454);
}

#m_deleteButton:hover,
#m_editCancelButton:hover,
#m_exitPracticeButton:hover,
#removeDefinitionButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f78989, stop: 1 #e06c6c);
}

#m_deleteButton:pressed,
#m_editCancelButton:pressed,
#m_exitPracticeButton:pressed,
#removeDefinitionButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e15c5c, stop: 1 #c04a4a);
}

/* ---- 列表视图 ---- */
QListView {
    border: 2px solid #dcdfe6;
    border-radius: 6px;
    background-color: white;
    font-size: 14px;
    outline: none;
    color: #2c3e50;
}

QListView::item {
    border-bottom: 1px solid #ebeef5;
    padding: 4px 8px;
}

QListView::item:selected {
    background-color: #ecf5ff;
    color: #409eff;
}

QListView::item:hover {
    background-color: #f5f7fa;
}

/* 旧版 QListWidget 兼容 */
QListWidget {
    border: 2px solid #dcdfe6;
    border-radius: 6px;
    background-color: white;
    font-size: 14px;
    outline: none;
    color: #2c3e50;
}

QListWidget::item {
    border-bottom: 1px solid #ebeef5;
    padding: 8px 12px;
}

QListWidget::item:selected {
    background-color: #ecf5ff;
    color: #409eff;
    border: 1px solid #409eff;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #f5f7fa;
}

/* ---- 标签 ---- */
QLabel {
    color: #2c3e50;
    font-size: 14px;
}

/* 练习界面特殊标签 */
#m_questionLabel {
    font-size: 18px;
    font-weight: bold;
    padding: 16px 20px;
    background-color: white;
    border-radius: 8px;
    border: 2px solid #e4e7ed;
    min-height: 50px;
    color: #303133;
}

#m_practiceTimerLabel {
    font-size: 18px;
    font-weight: bold;
    color: #409eff;
    padding: 8px 16px;
    background-color: white;
    border-radius: 6px;
    border: 1px solid #ebeef5;
}

#m_practiceAccuracyLabel {
    font-size: 15px;
    font-weight: bold;
    color: #67c23a;
    padding: 10px 16px;
    background-color: white;
    border-radius: 6px;
    border: 1px solid #ebeef5;
}

/* 单词计数标签 */
#m_wordCountLabel {
    color: #909399;
    font-size: 13px;
    padding: 4px 8px;
}

/* ---- 表单布局标签 ---- */
QFormLayout QLabel {
    font-weight: bold;
    color: #606266;
}

/* ---- 对话框 ---- */
QDialog {
    background-color: #f5f7fa;
    border-radius: 8px;
}

/* ---- 右键菜单 ---- */
QMenu {
    background-color: white;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 28px 8px 20px;
    border-radius: 4px;
    color: #2c3e50;
}

QMenu::item:selected {
    background-color: #ecf5ff;
    color: #409eff;
}

QMenu::separator {
    height: 1px;
    background: #ebeef5;
    margin: 4px 8px;
}

/* ---- 滚动条 ---- */
QScrollBar:horizontal {
    border: none;
    background: #f1f1f1;
    height: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #c1c1c1;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #a8a8a8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar:vertical {
    border: none;
    background: #f1f1f1;
    width: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #c1c1c1;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #a8a8a8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- 组合框下拉 ---- */
QComboBox QAbstractItemView {
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    background-color: white;
    color: #2c3e50;
    selection-background-color: #409eff;
    selection-color: white;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #ebeef5;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #409eff;
    color: white;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f5f7fa;
    color: #2c3e50;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #f5f7fa;
    border-top: 1px solid #e4e7ed;
    color: #909399;
    font-size: 13px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #909399;
    font-size: 13px;
    padding: 2px 8px;
}

/* ---- 工具提示 ---- */
QToolTip {
    background-color: white;
    color: #303133;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
