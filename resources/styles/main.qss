/* ============================================================
 * WordMemorizer 全局样式表（模板）
 * 配色方案基于 Element UI：
 *   主色 #409eff | 成功 #67c23a | 警告 #e6a23c | 危险 #f56c6c
 *   背景 #f5f7fa | 文字 #2c3e50 | 边框 #dcdfe6
 *
 * 本文件为模板，${token} 是设计 token 占位符，由 Theme::styleSheet()
 * 读取后从 widgets/theme.{h,cpp} 注入。请勿在此直接写死颜色，
 * 所有颜色、圆角、字号 token 统一在 Theme 中维护。
 * ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: ${bgPage};
    color: ${textRegular};
}

QWidget {
    color: ${textRegular};
    font-size: ${fontBase};
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
}

/* ---- 分组框 ---- */
QGroupBox {
    font-weight: bold;
    font-size: ${fontBase};
    color: ${textRegular};
    border: 2px solid ${borderBase};
    border-radius: ${radiusLg};
    margin-top: 12px;
    padding: 16px 10px 10px 10px;
    background-color: ${bgWhite};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: ${primary};
}

/* ---- 输入控件 ---- */
QLineEdit,
QComboBox {
    border: 2px solid ${borderBase};
    border-radius: ${radius};
    padding: 8px 12px;
    font-size: ${fontBase};
    background-color: ${bgWhite};
    color: ${textRegular};
    selection-background-color: ${primary};
    selection-color: ${bgWhite};
}

QLineEdit:focus,
QComboBox:focus {
    border-color: ${primary};
    background-color: ${primaryFocusBg};
}

QComboBox::drop-down {
    border: none;
    padding-right: 10%;
}

QComboBox::down-arrow {
    image: url(:/resources/icons/dropdown.png);
    width: 16px;
    height: 16px;
}

/* ---- QSpinBox ---- */
QSpinBox {
    padding: 8px 22px 8px 12px;
    border: 2px solid ${borderBase};
    border-radius: ${radius};
    background-color: ${bgWhite};
    font-size: ${fontBase};
    color: ${textRegular};
    min-height: 20px;
}

QSpinBox:focus {
    border-color: ${primary};
    background-color: ${primaryFocusBg};
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    height: 12px;
    border: none;
    background: transparent;
    image: url(:/resources/icons/up_arrow_normal.png);
    margin-top: 2px;
    margin-right: 2px;
}

QSpinBox::up-button:hover {
    image: url(:/resources/icons/up_arrow_hover.png);
}

QSpinBox::up-button:pressed {
    image: url(:/resources/icons/up_arrow_pressed.png);
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    height: 12px;
    border: none;
    background: transparent;
    image: url(:/resources/icons/down_arrow_normal.png);
    margin-bottom: 2px;
    margin-right: 2px;
}

QSpinBox::down-button:hover {
    image: url(:/resources/icons/down_arrow_hover.png);
}

QSpinBox::down-button:pressed {
    image: url(:/resources/icons/down_arrow_pressed.png);
}

/* ---- 按钮（渐变主样式，默认即主色 variant="primary"）---- */
QPushButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${primary}, stop: 1 ${primaryDark});
    border: none;
    border-radius: ${radius};
    color: ${bgWhite};
    padding: 8px 16px;
    font-weight: bold;
    font-size: ${fontBase};
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${primaryLight}, stop: 1 ${primaryLightDark});
}

QPushButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${primaryPressed}, stop: 1 ${primaryPressedDark});
}

QPushButton:disabled {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${disabledBg}, stop: 1 ${disabledBgDark});
    color: ${textSecondary};
}

/* ---- 按钮变体：成功（添加/保存）---- */
QPushButton[variant="success"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${success}, stop: 1 ${successDark});
}

QPushButton[variant="success"]:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${successLight}, stop: 1 ${successLightDark});
}

QPushButton[variant="success"]:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${successPressed}, stop: 1 ${successPressedDark});
}

/* ---- 按钮变体：危险（删除/取消/退出）---- */
QPushButton[variant="danger"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${danger}, stop: 1 ${dangerDark});
}

QPushButton[variant="danger"]:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${dangerLight}, stop: 1 ${dangerLightDark});
}

QPushButton[variant="danger"]:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 ${dangerPressed}, stop: 1 ${dangerPressedDark});
}

/* ---- 列表视图（QListView 与旧版 QListWidget 统一）----
 * 说明：QListView::item 不设 border，否则 Qt 会接管项绘制并忽略模型
 * 通过 Qt::BackgroundRole / Qt::ForegroundRole 提供的按数据着色
 * （练习结果列表依赖此能力）。需要分隔线的列表用 objectName 单独指定。 */
QListView,
QListWidget {
    border: 2px solid ${borderBase};
    border-radius: ${radius};
    background-color: ${bgWhite};
    font-size: ${fontBase};
    outline: none;
    color: ${textRegular};
}

QListView::item,
QListWidget::item {
    padding: 4px 8px;
}

/* 分隔线：仅用于不按数据着色的普通列表 */
QListWidget::item,
#practiceRecordView::item,
#wordListView::item {
    border-bottom: 1px solid ${borderLight};
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: ${bgSelected};
    color: ${primary};
}

QListView::item:hover,
QListWidget::item:hover {
    background-color: ${bgHover};
}

/* ---- 标签 ---- */
QLabel {
    color: ${textRegular};
    font-size: ${fontBase};
}

/* 练习界面特殊标签 */
#questionLabel {
    font-size: ${fontXl};
    font-weight: bold;
    padding: 16px 20px;
    background-color: ${bgWhite};
    border-radius: ${radiusLg};
    border: 2px solid ${borderLighter};
    min-height: 50px;
    color: ${textPrimary};
}

#practiceTimerLabel {
    font-size: ${fontXl};
    font-weight: bold;
    color: ${primary};
    padding: 8px 16px;
    background-color: ${bgWhite};
    border-radius: ${radius};
    border: 1px solid ${borderLight};
}

#practiceAccuracyLabel {
    font-size: ${fontLg};
    font-weight: bold;
    color: ${success};
    padding: 10px 16px;
    background-color: ${bgWhite};
    border-radius: ${radius};
    border: 1px solid ${borderLight};
}

/* 单词计数标签 */
#wordCountLabel {
    color: ${textSecondary};
    font-size: ${fontSm};
    padding: 4px 8px;
}

/* ---- 表单布局标签 ---- */
QFormLayout QLabel {
    font-weight: bold;
    color: ${textLabel};
}

/* ---- 对话框 ---- */
QDialog {
    background-color: ${bgPage};
    border-radius: ${radiusLg};
}

/* ---- 右键菜单 ---- */
QMenu {
    background-color: ${bgWhite};
    border: 1px solid ${borderBase};
    border-radius: ${radius};
    padding: 5px;
}

QMenu::item {
    padding: 8px 28px 8px 20px;
    border-radius: ${radiusSm};
    color: ${textRegular};
}

QMenu::item:selected {
    background-color: ${bgSelected};
    color: ${primary};
}

QMenu::separator {
    height: 1px;
    background: ${borderLight};
    margin: 4px 8px;
}

/* ---- 滚动条 ---- */
QScrollBar:horizontal {
    border: none;
    background: ${scrollTrack};
    height: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: ${scrollHandle};
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: ${scrollHandleHover};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar:vertical {
    border: none;
    background: ${scrollTrack};
    width: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: ${scrollHandle};
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: ${scrollHandleHover};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- 组合框下拉 ---- */
QComboBox QAbstractItemView {
    border: 1px solid ${borderBase};
    border-radius: ${radius};
    background-color: ${bgWhite};
    color: ${textRegular};
    selection-background-color: ${primary};
    selection-color: ${bgWhite};
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-bottom: 1px solid ${borderLight};
}

QComboBox QAbstractItemView::item:selected {
    background-color: ${primary};
    color: ${bgWhite};
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: ${bgHover};
    color: ${textRegular};
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: ${bgPage};
    border-top: 1px solid ${borderLighter};
    color: ${textSecondary};
    font-size: ${fontSm};
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: ${textSecondary};
    font-size: ${fontSm};
    padding: 2px 8px;
}

/* ---- 工具提示 ---- */
QToolTip {
    background-color: ${bgWhite};
    color: ${textPrimary};
    border: 1px solid ${borderBase};
    border-radius: ${radius};
    padding: 8px 12px;
    font-size: ${fontSm};
}
