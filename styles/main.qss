/* 全局样式 */
QMainWindow {
    background-color: #f5f7fa;
    color: #2c3e50;
}

QGroupBox {
    font-weight: bold;
    font-size: 14px;
    color: #2c3e50;
    border: 2px solid #dcdfe6;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px 0 8px;
    color: #409eff;
}

/* 输入框样式 */
QLineEdit,
QSpinBox,
QComboBox {
    border: 2px solid #dcdfe6;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: white;
    color: #2c3e50;
    selection-background-color: #409eff;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #409eff;
    background-color: #f0f7ff;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10%;
}

QComboBox::down-arrow {
    image: url(:/icons/dropdown.png);
    width: 16px;
    height: 16px;
}

/* 设置 QSpinBox 整体样式，为按钮留出空间 */
QSpinBox {
    padding-right: 22px; /* 略大于按钮宽度，避免文字被遮挡 */
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: white;
    min-height: 24px; /* 根据需要调整 */
}

/* ========== 上箭头按钮 ========== */

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    height: 12px;
    border: none;
    background: transparent;
    /* 默认状态：正常图片 */
    image: url(:/icons/up_arrow_normal.png);
    margin-top: 2px;     /* 微调垂直位置 */
    margin-right: 2px;   /* 微调水平位置 */
}

/* 悬停状态 */
QSpinBox::up-button:hover {
    image: url(:/icons/up_arrow_hover.png);
}

/* 按下状态 */
QSpinBox::up-button:pressed {
    image: url(:/icons/up_arrow_pressed.png);
}

/* ========== 下箭头按钮 ========== */

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    height: 12px;
    border: none;
    background: transparent;
    /* 默认状态：正常图片 */
    image: url(:/icons/down_arrow_normal.png);
    margin-bottom: 2px;  /* 微调垂直位置 */
    margin-right: 2px;   /* 微调水平位置 */
}

/* 悬停状态 */
QSpinBox::down-button:hover {
    image: url(:/icons/down_arrow_hover.png);
}

/* 按下状态 */
QSpinBox::down-button:pressed {
    image: url(:/icons/down_arrow_pressed.png);
}

/* 按钮样式 */
QPushButton {
    background-color: #409eff;
    border: none;
    border-radius: 6px;
    color: white;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #66b1ff;
}

QPushButton:pressed {
    background-color: #3a8ee6;
}

QPushButton:disabled {
    background-color: #c0c4cc;
    color: #909399;
}

/* 特殊按钮样式 */
#m_addButton,
#m_editSaveButton {
    background-color: #67c23a;
}

#m_addButton:hover,
#m_editSaveButton:hover {
    background-color: #85ce61;
}

#m_deleteButton,
#m_editCancelButton,
#m_exitPracticeButton {
    background-color: #f56c6c;
}

#m_deleteButton:hover,
#m_editCancelButton:hover,
#m_exitPracticeButton:hover {
    background-color: #f78989;
}

/* 列表控件样式 */
QListWidget {
    border: 2px solid #dcdfe6;
    border-radius: 6px;
    background-color: white;
    font-size: 14px;
    outline: none;
    color: #2c3e50;
}

QListWidget::item {
    border-bottom: 1px solid #ebeef5;
    padding: 8px 12px;
}

QListWidget::item:selected {
    background-color: #ecf5ff;
    color: #409eff;
    border: 1px solid #409eff;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #f5f7fa;
}

/* 标签样式 */
QLabel {
    color: #2c3e50;
    font-size: 14px;
}

/* 特殊标签样式 */
#m_questionLabel,
#m_practiceTimerLabel,
#m_practiceAccuracyLabel {
    font-size: 16px;
    font-weight: bold;
    padding: 10px;
    background-color: white;
    border-radius: 6px;
    border: 1px solid #ebeef5;
    min-height: 40px;
}

#m_practiceTimerLabel {
    font-size: 18px;
    color: #409eff;
}

#m_practiceAccuracyLabel {
    font-size: 14px;
    color: #67c23a;
}

/* 表单布局标签 */
QFormLayout QLabel {
    font-weight: bold;
    color: #606266;
}

/* 对话框样式 */
QDialog {
    background-color: #f5f7fa;
    border-radius: 8px;
}

/* 菜单样式 */
QMenu {
    background-color: white;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 20px 8px 20px;
    border-radius: 4px;
    color: #2c3e50;
}

QMenu::item:selected {
    background-color: #ecf5ff;
    color: #409eff;
}

/* 滚动条样式 */
QScrollBar:horizontal {
    border: none;
    background: #f1f1f1;
    height: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #c1c1c1;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #a8a8a8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar:vertical {
    border: none;
    background: #f1f1f1;
    width: 10px;
    border-radius: 5px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #c1c1c1;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #a8a8a8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* 组合框下拉菜单样式 */
QComboBox QAbstractItemView {
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    background-color: white;
    color: #2c3e50;
    selection-background-color: #409eff;
    selection-color: white;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #ebeef5;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #409eff;
    color: white;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f5f7fa;
    color: #2c3e50;
}

/* 按钮样式 */
QPushButton {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #409eff,
        stop: 1 #337ecc
    );
    border: none;
    border-radius: 6px;
    color: white;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 14px;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #66b1ff,
        stop: 1 #5298e6
    );
}

QPushButton:pressed {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #3a8ee6,
        stop: 1 #2d7fcc
    );
}

QPushButton:disabled {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #c0c4cc,
        stop: 1 #a8abb2
    );
    color: #909399;
}

/* 特殊按钮样式 */
#m_addButton,
#m_editSaveButton {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #67c23a,
        stop: 1 #529b2e
    );
}

#m_addButton:hover,
#m_editSaveButton:hover {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #85ce61,
        stop: 1 #6bb749
    );
}

#m_addButton:pressed,
#m_editSaveButton:pressed {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #5daf34,
        stop: 1 #4a8c2a
    );
}

#m_deleteButton,
#m_editCancelButton,
#m_exitPracticeButton {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #f56c6c,
        stop: 1 #d65454
    );
}

#m_deleteButton:hover,
#m_editCancelButton:hover,
#m_exitPracticeButton:hover {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #f78989,
        stop: 1 #e06c6c
    );
}

#m_deleteButton:pressed,
#m_editCancelButton:pressed,
#m_exitPracticeButton:pressed {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 #e15c5c,
        stop: 1 #c04a4a
    );
}
